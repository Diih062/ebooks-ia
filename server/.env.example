# Exemplos de variáveis de ambiente necessárias para rodar o backend

# Banco de dados PostgreSQL
# Ex.: postgres://user:pass@host:5432/dbname
DATABASE_URL=

# Redis (se usar Upstash, prefira o formato rediss://)
REDIS_URL=

# SendPulse (integração de marketing/SMTP)
SENDPULSE_API_USER_ID=
SENDPULSE_API_SECRET=
SENDPULSE_BOOK_ID=
SENDPULSE_SENDER_EMAIL=
SENDPULSE_SENDER_NAME=Ebooks IA

# Opcional: webhook para receber alertas do monitor de Redis
ALERT_WEBHOOK_URL=

# Porta e ambiente
PORT=10000
NODE_ENV=development
PORT=10000
DATABASE_URL=postgresql://user:pass@host:5432/db
REDIS_URL=rediss://default:...@...:6379
