# Porta do servidor Express
PORT=3000

# PostgreSQL (usado internamente no Docker)
PGHOST=db
PGUSER=postgres
PGPASSWORD=secret
PGDATABASE=leads
PGPORT=5432

# SendPulse (NÃO colocar valores reais aqui)
SENDPULSE_CLIENT_ID=YOUR_CLIENT_ID
SENDPULSE_CLIENT_SECRET=YOUR_CLIENT_SECRET
SENDPULSE_BOOK_ID=YOUR_ADDRESS_BOOK_ID

# Redis (para fila)
REDIS_HOST=redis
REDIS_PORT=6379
